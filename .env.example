# School + MZK schedule API (server-only). Required — the app does not read data/*.json.
# Health: GET $DOWOZY_API_BASE_URL/health
# School: GET $DOWOZY_API_BASE_URL/api/v1/dowozy/schedule
# MZK:    GET $DOWOZY_API_BASE_URL/api/v1/mzk/schedule
# MZK meta: GET $DOWOZY_API_BASE_URL/api/v1/mzk/meta
# Responses are cached by Next.js Data Cache (~2 min; health ~30 s).
DOWOZY_API_BASE_URL=http://localhost:8000
# Auth / users / billing / push API origin (server-only). Required in production.
# Often the same host as DOWOZY_API_BASE_URL when one backend serves both.
BACKEND_API_URL=http://localhost:8000
# Must equal the backend AUTH__SERVICE_KEY. Sent as X-Service-Key on every backend call.
BACKEND_SERVICE_KEY=
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=you@example.com
FEEDBACK_FROM_EMAIL=Feedback <onboarding@resend.dev>
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional canonical site URL for SEO (sitemap / Open Graph). On Vercel, VERCEL_URL is used as fallback.
# Backend AUTH__LINK_BASE_URL should match this value (login links in magic-link emails).
NEXT_PUBLIC_SITE_URL=
# PostHog (client). Leave KEY empty to disable. EU cloud host recommended.
# Project API key from https://eu.posthog.com → Project settings.
# Uses memory persistence only (no PostHog cookies) — see privacy policy.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
# Durable feedback rate limit and settings-transfer QR codes (https://upstash.com).
# Without these, feedback uses an in-memory limit and device transfer is unavailable.
# Plan Plus billing and Web Push (subscriptions, VAPID send, reminder dispatch) live on the backend.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Required for settings transfer QR: encrypts payloads at rest in Redis (AES-256-GCM).
# Generate with: openssl rand -base64 32
SETTINGS_TRANSFER_SECRET=
# Web Push: public VAPID key (same pair as backend PUSH__VAPID_*).
# On Railway prefer VAPID_PUBLIC_KEY (runtime, not inlined at build).
# NEXT_PUBLIC_* is a client fallback only — generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Temporary: show push settings UI on /instalacja ("true" to enable).
PUSH_NOTIFICATIONS_UI_ENABLED=
