# Local only: school + MZK schedule API (server-only). Leave empty on production Vercel.
# Empty = repo JSON snapshots / scrape Actions (current production behavior).
# Health: GET $DOWOZY_API_BASE_URL/health
# School: GET $DOWOZY_API_BASE_URL/api/v1/dowozy/schedule
# MZK:    GET $DOWOZY_API_BASE_URL/api/v1/mzk/schedule
# MZK meta: GET $DOWOZY_API_BASE_URL/api/v1/mzk/meta
DOWOZY_API_BASE_URL=http://localhost:8000
# Auth / users API origin (server-only). Required in production for magic-link login.
# Separate from DOWOZY_API_BASE_URL so schedule can stay on repo JSON while auth uses the backend.
BACKEND_API_URL=http://localhost:8000
# Must equal the backend AUTH__SERVICE_KEY. Sent as X-Service-Key on every backend call.
BACKEND_SERVICE_KEY=
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=you@example.com
FEEDBACK_FROM_EMAIL=Feedback <onboarding@resend.dev>
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional canonical site URL for SEO (sitemap / Open Graph). On Vercel, VERCEL_URL is used as fallback.
# Backend AUTH__LINK_BASE_URL should match this value (login links in magic-link emails).
NEXT_PUBLIC_SITE_URL=
# Durable feedback rate limit, settings-transfer QR codes, push subscriptions, and Plan Plus billing (https://upstash.com).
# Without these, feedback uses an in-memory limit, device transfer is unavailable, and subscribe returns 503.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Required for settings transfer QR: encrypts payloads at rest in Redis (AES-256-GCM).
# Generate with: openssl rand -base64 32
SETTINGS_TRANSFER_SECRET=
# Stripe — Plan Plus, one-time 30 PLN. Server only, never NEXT_PUBLIC_.
# Secret key: https://dashboard.stripe.com/apikeys (sk_test_… or sk_live_…)
# Price: a one-time Price in PLN (price_…). Enable card, BLIK, Apple Pay and Google Pay in the Dashboard.
# Webhook: https://YOUR_DOMAIN/api/billing/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded, charge.refunded.
# Signing secret from that endpoint (whsec_…). Locally: stripe listen --forward-to localhost:3000/api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Web Push (npx web-push generate-vapid-keys). Subject is a mailto: or https: URL.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Temporary: show push settings UI on /instalacja ("true" to enable).
PUSH_NOTIFICATIONS_UI_ENABLED=
# Upstash QStash calls POST /api/push/dispatch every 5 minutes on weekdays.
# Signing keys: https://console.upstash.com/qstash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# One-time schedule against the production URL (Mon–Fri only).
# If a schedule already exists, update its cron in the Upstash QStash console
# (or delete and recreate) — schedules are not stored in this repo.
# curl -X POST "https://qstash.upstash.io/v2/schedules/https://YOUR_DOMAIN/api/push/dispatch" \
#   -H "Authorization: Bearer $QSTASH_TOKEN" \
#   -H "Upstash-Cron: */5 * * * 1-5"
