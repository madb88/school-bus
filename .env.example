RESEND_API_KEY=
FEEDBACK_TO_EMAIL=you@example.com
FEEDBACK_FROM_EMAIL=Feedback <onboarding@resend.dev>
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional canonical site URL for SEO (sitemap / Open Graph). On Vercel, VERCEL_URL is used as fallback.
NEXT_PUBLIC_SITE_URL=
# Optional durable feedback rate limit + settings transfer QR codes (https://upstash.com).
# Without these, feedback uses an in-memory limit and device transfer is unavailable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Required for settings transfer QR: encrypts payloads at rest in Redis (AES-256-GCM).
# Generate with: openssl rand -base64 32
SETTINGS_TRANSFER_SECRET=
